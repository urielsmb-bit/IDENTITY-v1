# ============================================================
# sharee · Apache/LiteSpeed (Hostinger)
#
# Traduce lo que en Vercel hacia `vercel.json`: el encaminamiento de una
# sola pagina, la pieza que pone las etiquetas de cada perfil, y las
# cabeceras de seguridad. Si algo de esto falta, el sitio "funciona" pero
# mal de una forma que no se nota hasta que es tarde: los enlaces
# compartidos salen sin tarjeta, o recargar dentro de un perfil da 404.
# ============================================================

Options -Indexes
DirectoryIndex index.html

# Sin la barra automatica. Apache redirige `/carpeta` a `/carpeta/` ANTES
# de mirar las reglas de abajo, y eso le quitaba `/ayuda` a la aplicacion
# (ver «la ayuda», mas abajo). Con los listados apagados —`-Indexes`,
# arriba— no hay nada que esa redireccion estuviera protegiendo.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---- 1 · la direccion vieja, redirigida ---------------------------
  # `/u/<usuario>` fue la forma anterior. Se redirige con un 301 en el
  # SERVIDOR y no solo en el navegador: un robot que lea la tarjeta no
  # ejecuta JavaScript, asi que una redireccion hecha en React no la ve.
  RewriteRule ^u/([A-Za-z0-9_.-]{1,32})/?$ /$1 [R=301,L]

  # ---- un solo dominio ---------------------------------------------
  # `www.sharee.fun` respondia 200 por su cuenta, o sea DOS sitios con el
  # mismo contenido: los buscadores reparten la autoridad entre los dos y
  # las visitas se cuentan en dos sitios. Y la lista blanca de Vimeo y la
  # de CORS hay que mantenerla por duplicado.
  #
  # Se manda al dominio sin `www`, que es el que esta en los enlaces que
  # comparte la gente. 301 y no 302: es permanente, y un 302 no traslada
  # nada de lo ganado.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ---- la ayuda: una pagina Y una carpeta ----------------------------
  # `/ayuda` es la pagina del centro de ayuda y `ayuda/` es la carpeta de
  # sus articulos (`ayuda/discord.md`). Como la carpeta existe, las reglas
  # de abajo se la saltaban —`!-d`— y Apache hacia lo suyo con una carpeta:
  # redirigir a `/ayuda/` y, sin indice dentro, contestar 403.
  #
  # Medido en produccion: `/ayuda` -> 301 -> `/ayuda/` -> 403. O sea que
  # entrar al centro de ayuda desde Google, desde un enlace o recargando
  # daba «prohibido». Solo funcionaba navegando dentro de la aplicacion.
  #
  # Aqui arriba, antes de que nadie la trate como carpeta. Los `.md` de
  # dentro no pasan por aqui: esos si son ficheros y se sirven tal cual.
  RewriteRule ^ayuda/?$ index.html [L]

  # ---- el sitemap ---------------------------------------------------
  # Antes de la regla de los perfiles, que lo tomaria por un nombre de
  # usuario. Un nombre no puede llevar punto, asi que no le quita el sitio
  # a nadie.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ---- 2 · el perfil pasa por PHP ----------------------------------
  # Un solo segmento que no sea una ruta de la aplicacion ni un fichero de
  # verdad es un nombre de usuario. Es lo unico que NO puede resolver el
  # navegador: la tarjeta de vista previa la lee un robot que no ejecuta
  # JavaScript, y `perfil.php` le devuelve el index.html con las etiquetas
  # ya puestas.
  #
  # La lista de rutas va aqui Y en la tabla `nombres_reservados` de la base:
  # aqui decide como se sirve una direccion, y alli impide que alguien se
  # registre con ese nombre y se quede sin perfil accesible. Si se añade una
  # ruta, se añade en los dos sitios.
  #
  # `[L]` y no `[R]`: se sirve aqui mismo. Una redireccion cambiaria la
  # direccion que ve quien comparte el enlace.
  RewriteCond %{REQUEST_URI} !^/(dashboard|entrar|top|analytics|plantillas|templates|probar|pricing|terminos|privacidad|copyright|salud|ayuda|admin|assets|fuentes|api)(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([A-Za-z0-9_.-]{1,32})/?$ perfil.php?u=$1 [L,QSA]

  # ---- 3 · el resto, a la aplicacion -------------------------------
  # Todo lo que no sea un fichero de verdad lo pinta React. Sin esto,
  # entrar directo a /top o recargar dentro de /dashboard da 404: esas
  # rutas no existen en el disco, existen en el navegador.
  #
  # PERO `assets/` Y `fuentes/` NO. Esa es la regla que faltaba, y costaba
  # caro: un fichero que ya no esta ahi caia en este cajon y se respondia
  # el HTML del cascaron CON ESTADO 200.
  #
  # Medido en produccion:
  #
  #     /assets/index-DG7myCpD.js  ->  200  text/html
  #     /assets/index-C1Lk_1Wy.js  ->  200  text/html
  #     /assets/no-existe.js       ->  200  text/html
  #
  # Los dos primeros son bundles de despliegues anteriores que `rsync
  # --delete` borro, como debe. Y ahi esta el problema entero:
  #
  #   1. Alguien vuelve con el HTML de su visita anterior en el navegador.
  #   2. Ese HTML pide su bundle, que ya no existe.
  #   3. En vez de un 404 recibe el HTML del cascaron, con un 200.
  #   4. El navegador intenta ejecutar HTML como JavaScript, el tipo MIME
  #      no cuadra, y bloquea el guion.
  #   5. Pagina en blanco. Y como es un 200, nada reintenta.
  #
  # `vite:preloadError` —que ya esta puesto en `main.tsx` y recarga sola—
  # no puede saltar, porque no hubo fallo de red que capturar: hubo un 200.
  # Un 404 de verdad es lo que le devuelve la vida a ese rescate.
  #
  # Y `.well-known/` tampoco, por lo mismo al reves: ahi los robots buscan
  # ficheros con nombre fijo —`security.txt`, los de las apps— y un 200 con
  # el HTML de la pagina les dice que existen y que son basura. Medido:
  # `/.well-known/security.txt` -> 200 text/html. Lo que no este, 404.
  RewriteCond %{REQUEST_URI} !^/(assets|fuentes|\.well-known)/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# ---- 4 · las cabeceras de seguridad -------------------------------
# Las mismas de `react/vercel.json`, palabra por palabra. La CSP es la que
# decide que se puede incrustar y a donde se puede llamar: si se queda
# corta, deja de sonar la musica o de verse el fondo de video; si se pasa,
# deja de servir para nada.
<IfModule mod_headers.c>
  # Los dos hosts de Cloudflare son para su medidor de visitas, que estaba
  # BLOQUEADO en cada carga: el navegador lo rechazaba y salia un error rojo
  # en la consola de cualquiera que abriera un perfil.
  #
  # Se anaden en vez de apagarlo porque ese medidor da lo unico que no se
  # puede medir desde aqui: INP, LCP y CLS de visitantes REALES, en sus
  # maquinas. Ahora mismo se esta persiguiendo justamente eso -por que la
  # pagina va a tirones sin aceleracion por hardware- y las medidas propias
  # salen todas de un equipo con tarjeta grafica, que es el caso que NO
  # falla.
  #
  # Son dos hosts exactos y nada mas: el del guion y el que recibe el dato.
  # Sin comodines, sin 'unsafe-inline', y no se toca ninguna otra directiva.
  #
  # Y los de Tebex, que cobra el Premium: `js.tebex.io` es el guion del
  # pago, `headless.tebex.io` donde se crea la cesta, y `pay`/`portal` la
  # ventana del pago y la de sus recibos. El guion solo se descarga cuando
  # alguien pulsa «Conseguir Premium».
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://static.cloudflareinsights.com https://js.tebex.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://headless.tebex.io https://*.r2.cloudflarestorage.com https://cloudflareinsights.com https://discord.com https://vimeo.com https://*.vimeo.com https://*.cloud.vimeo.com https://ypvipmhfnraalcqbttiq.supabase.co wss://ypvipmhfnraalcqbttiq.supabase.co https://open.spotify.com https://api.spotify.com https://accounts.spotify.com; frame-src https://pay.tebex.io https://portal.tebex.io https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://player.vimeo.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
  # El navegador se acuerda de que este sitio es SOLO https durante un ano, y
  # a partir de la primera visita deja de intentarlo en claro. Sin esto, quien
  # escriba «sharee.fun» a pelo hace el primer viaje sin cifrar, y ese viaje
  # es el que se puede interceptar en una red que no sea suya.
  #
  # `preload` queda fuera a proposito: entrar en la lista de los navegadores
  # es facil y salir tarda meses. Se pone cuando el dominio este asentado.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Los permisos que este sitio NO usa, apagados de entrada. No es que hoy
  # alguien los este pidiendo: es que si manana entra una dependencia que
  # los pide, no los tiene. Se apaga lo que sobra, no lo que molesta.
  #
  # Faltan a proposito `autoplay` y `fullscreen`: los necesitan los
  # reproductores incrustados de YouTube, Vimeo y Spotify. Apagarlos aqui
  # dejaria la musica muda y el fondo de video quieto, que es la clase de
  # «endurecer» que rompe el producto.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), hid=(), display-capture=(), screen-wake-lock=(), idle-detection=(), local-fonts=(), xr-spatial-tracking=(), browsing-topics=(), interest-cohort=()"

  # Corta el hilo entre esta pestana y la que la haya abierto, y al reves.
  # Sin esto, una pagina de otro sitio que abra sharee.fun conserva una
  # referencia a esta ventana y puede medirla de refilon —cuanto tarda en
  # cargar, cuantos marcos tiene— para averiguar si quien mira tiene
  # sesion. Son las fugas de canal lateral entre ventanas.
  #
  # Es `same-origin-allow-popups` y no `same-origin` porque la version
  # estricta tambien corta las ventanas que abre ESTA pagina. Hoy no hace
  # falta —se entra por redireccion completa, comprobado— pero el dia que
  # alguien meta un acceso en ventana emergente, la version estricta lo
  # rompe en silencio y esta no.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Nada de politicas de dominio cruzado de Flash y compania. Estan muertas,
  # pero un `crossdomain.xml` que alguien suba por error sigue valiendo.
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # ---- lo que se guarda, y por cuanto --------------------------------
  #
  # SE DECIDE POR EL NOMBRE, NO POR LA EXTENSION. Aqui habia una sola regla
  # que casaba `js|css|woff2|png|jpg|jpeg|webp|avif|svg` en cualquier sitio
  # y les ponia un año de `immutable`. El comentario decia «los ficheros de
  # `assets/` llevan un resumen en el nombre», que es verdad — pero la
  # regla no lo comprobaba, asi que tambien alcanzaba a lo que NO lo lleva.
  #
  # Medido en produccion antes de arreglarlo:
  #
  #     /icono.svg -> max-age=31536000, immutable   ·   Age: 613585
  #
  # Siete dias servido de una copia que dura un año, con nombre fijo. O
  # sea: cambiar el logo y que nadie lo vea hasta 2027.
  #
  # `immutable` solo es seguro cuando el nombre cambia con el contenido.
  # Vite pone un resumen de ocho caracteres antes de la extension
  # -`index-C2EGOy88.js`- y ESO es lo que se comprueba. Lo que no lo lleva
  # se guarda tambien, pero con fecha de caducidad y con `ETag`, asi que
  # preguntar cuesta una respuesta vacia y no una descarga.
  #
  # El orden importa: `Header set` pisa lo puesto antes, asi que lo general
  # va primero y la regla del resumen al final, que es la que manda.

  # 1 · Imagenes e iconos sin resumen. Una hora.
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # 2 · Fuentes. Nombre fijo, pero un `.woff2` no cambia de contenido casi
  #     nunca: una semana.
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>

  # 3 · Los documentos que se leen DENTRO de la pagina —los legales, los
  #     articulos de ayuda— y el manifiesto. Los edita una persona y no
  #     llevan resumen: cinco minutos. Sin esto no tenian NINGUNA cabecera
  #     y el navegador se inventaba cuanto guardarlos.
  <FilesMatch "\.(md|webmanifest|json|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # 4 · Y lo que lleva resumen de ocho caracteres: un año y sin preguntar.
  #     Va al final porque pisa a las tres de arriba: un `.woff2` dentro de
  #     `assets/` SI lleva resumen y merece el año.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 5 · El cascaron NO se guarda: es el que apunta a los ficheros con
  #     resumen, y guardado en el navegador dejaria a alguien con la
  #     version de antes para siempre.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- 5 · los tipos que el servidor no conoce -----------------------
# El Apache de aqui no sabe que es un `.avif` y lo servia como
# `text/plain`. Las imagenes se siguen viendo —el navegador las reconoce
# por su contenido, y `nosniff` solo frena a guiones y hojas de estilo,
# no a imagenes— asi que esto no rompia nada a la vista. Se arregla por
# dos motivos que si se notan:
#
#   · la compresion de aqui abajo incluye `text/plain`, o sea que cada
#     AVIF se gzipeaba. Un AVIF ya viene comprimido: es gastar procesador
#     en los dos lados para acabar con un fichero un pelin mas grande;
#   · un tipo mal puesto es una bomba de relojeria. Hoy los navegadores
#     perdonan con las imagenes; nadie ha prometido que manana tambien.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/avif-sequence .avifs
  # El manifiesto salia como `text/plain`. Chrome lo lee igual, pero es el
  # fichero que decide si sharee se puede instalar, y el tipo es parte de
  # lo que comprueba cualquier validador.
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- 6 · comprimir ------------------------------------------------
# Solo lo que de verdad encoge. Aqui NO van imagenes ni fuentes: ya
# vienen comprimidas, y pasarlas otra vez cuesta y no baja nada.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# ---- 7 · la configuracion no se sirve ------------------------------
# `config.php` lleva la clave anonima —la misma que ya va dentro del
# JavaScript, o sea que no es un secreto— pero servir un `.php` como texto
# por un fallo de configuracion es la clase de accidente que conviene
# impedir dos veces.
<FilesMatch "^(config\.php|\.env.*|_csp\.txt)$">
  Require all denied
</FilesMatch>
