# Supabase — Settings → API
# Sin estas dos, la app arranca en modo local (sin nube).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-or-publishable-key

# Opcional: Edge Function que cuenta las visitas.
# Vacío = se deduce de VITE_SUPABASE_URL (/functions/v1/registrar-vista).
VITE_FN_VISTAS=

# Opcional: subir los fondos de video a Vimeo en vez de a Supabase Storage.
# Cualquier valor lo enciende; vacio lo apaga. Necesita ademas una cuenta de
# Vimeo con permiso de subida por API, el token en los secretos de la funcion
# de borde, y esa funcion desplegada. Sin las tres cosas, dejalo vacio.
VITE_VIMEO=

# Opcional: cubo de Storage para avatares y fondos. Por defecto "media".
VITE_BUCKET_MEDIA=media

# Opcional: versión de los términos que se guarda al aceptar el alta.
VITE_VERSION_LEGAL=2026-08-29
